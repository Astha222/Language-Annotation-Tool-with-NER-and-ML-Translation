# Copy this file to backend/.env and edit it. The real .env is git-ignored: never commit it.

# ── Databases ───────────────────────────────────────────────────────────────────────────────────
# SQL (users and annotations). PostgreSQL for real use, or SQLite to try the project with no setup:
#   POSTGRES_URL=sqlite:///./annotationtool.db
POSTGRES_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/annotationtool
# MongoDB stores each annotation's entities. A local instance is enough, e.g.:  docker run -d -p 27017:27017 mongo
MONGO_URL=mongodb://localhost:27017
MONGO_DB=annotationtool

# ── Security ────────────────────────────────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
# If this is missing or shorter than 32 characters the server uses a random one and logs everybody out on restart.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Browser origins allowed to call the API (comma-separated). The defaults cover the Expo web app on localhost.
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Hosts that give every deployment its own address (Vercel previews): allow them with a NARROW pattern, never .*
# CORS_ORIGIN_REGEX=^https://annotation-tool(-[a-z0-9-]+)?\.vercel\.app$
# On Railway / Render / Heroku the database address may come as DATABASE_URL instead of POSTGRES_URL; both work (postgres:// is converted).

# ── Translation ─────────────────────────────────────────────────────────────────────────────────
# Providers are tried in this order; the first that works wins. Choices:
#   azure     Azure AI Translator (needs a key below; fastest and the most accurate for long documents)
#   local     open-source models that run on this machine: no key, no quota, text never leaves it.
#             Hindi uses IndicTrans2; other languages use Marian models. Models download on first use.
#   google    free unofficial Google endpoint (rate-limited; use at your own risk)
#   mymemory  free MyMemory API (about 5,000 characters/day)
# Default: azure first (skipped when no key is set), then the local models.
TRANSLATION_PROVIDERS=azure,local

# -- local models (all optional)
# Beam-search width: 1 = fastest, 2 = default, 4 = best quality (about 2x slower than 1).
LOCAL_MT_BEAMS=2
# CPU threads for PyTorch (default: PyTorch picks).
# LOCAL_MT_THREADS=4
# Set to 0 to refuse the IndicTrans2 models (they ship their own Python code, pinned to reviewed commits) and use
# the generic Marian models for Hindi as well. Much lower Hindi quality.
LOCAL_INDICTRANS=1
# How many translation models stay loaded in memory at once (each is about 1 GB for Hindi, 0.3 GB for Marian).
LOCAL_MT_MAX_LOADED=2
# English -> Japanese uses Helsinki-NLP/opus-tatoeba-en-ja (Apache-2.0). To try another Japanese model, e.g. the
# CC-BY-SA staka/fugumt-en-ja (fewer garbled outputs in our test, but a share-alike licence), set it here.
# LOCAL_MT_JA_MODEL=staka/fugumt-en-ja

# CPU threads PyTorch may use. Default: the number of PHYSICAL cores (needs psutil). On a 4-core / 8-thread laptop 8 threads
# made one NER call ~20% faster but translation ~34% slower, so documents (both at once) were slower. Raise it only if the
# server mostly handles one NER request at a time.
# TORCH_THREADS=4

# Text chunks per NER model call. 1 is fastest on a CPU (batching was 14-47% slower in our tests); raise it on a GPU.
# NER_BATCH_SIZE=1
# Optional: run the English NER model through ONNX Runtime (1.7-1.9x faster, identical results with the fp32 file).
# Create the folder once with:  python export_onnx_ner.py dslim/bert-base-NER   (needs the `onnx` package, see that file)
# then install onnxruntime and set:
# PREFERRED: put "onnx_dir" (and "onnx_file", default model.onnx = fp32) on the model's entry in backend/ner_models.json or your NER_MODELS_FILE (see README, "Faster CPU inference"):
# an export belongs to one model, and the app refuses an export that was made from another one.
# OLD WAY (English only, deprecated: it does not know which model the folder belongs to; a warning is logged):
# NER_ONNX_DIR=models/bert-base-NER-onnx
# NER_ONNX_FILE=model.onnx        # fp32: same results. model_int8.onnx is smaller (108 MB) but lost 0.012 F1 on Twitter text
# Cutting text before NER (neither beat the default in our tests, see IMPROVEMENT_LOG.md):
# NER_CHUNK_CHARS=800
# NER_STRIDE_TOKENS=0

# -- English NER model
# Default (decision D1, 2026-11-25): english-b-nofin, a distilroberta-base student trained on CoNLL-2003 + WNUT-2017 + BTC, English-EWT strict F1 0.762 against 0.703
# for dslim/bert-base-NER. If its weights cannot be loaded the app falls back to dslim/bert-base-NER and says so in the log and in GET /health/models.
# The value can be a model name from backend/ner_models.json, a Hugging Face model id or a local folder. Every model, route and how to add your own is in
# backend/ner_models.json and in README.md, "Changing or adding an NER model". To go back to the previous model:  NER_MODEL_EN=english-bert-base
# NER_MODEL_EN=english-bert-base
# Your own models and per-language routes (same shape as ner_models.json; its models are added, its routes replace the bundled ones):
# NER_MODELS_FILE=C:/path/to/my_ner_models.json

# -- Hindi NER model
# Default: neuronsbyisshu/indicbert-hi-ner-naamapadam (CC0), used for Hindi AND Marathi, Bengali, Tamil, Telugu, Gujarati, Kannada, Malayalam and Punjabi
# (trained on Hindi only, it transfers to the others; Odia and Assamese are not included): strict F1 0.83 / 0.76 on two Hindi test sets, against 0.65 / 0.53 for the
# multilingual model used before. It tags PER, ORG and LOC. (The old model never actually predicted dates either, so nothing was lost.)
# Set NER_MODEL_HI to a model id or folder to change it, for example multi-davlan-wikiann to get the old behaviour back.
# NER_MODEL_HI=neuronsbyisshu/indicbert-hi-ner-naamapadam

# -- NER model for every other language (French, Spanish, German, Chinese, Arabic, Japanese, Russian, ...)
# Default (decision D2(a), 2026-11-25): multi-davlan-hrl = Davlan/xlm-roberta-base-ner-hrl (AFL-3.0): Russian 0.74, Arabic 0.81, Japanese 0.64, German 0.82,
# Chinese 0.78 against 0.49 / 0.49 / 0.35 / 0.51 / 0.46 for the previous default, Davlan/xlm-roberta-base-wikiann-ner, which has NO declared licence
# (still available as NER_MODEL_MULTI=multi-davlan-wikiann to reproduce old results). Weaker on text without capital letters; multi-otter (registered, used for no language yet)
# is better there but runs code from its model repository; NER_ALLOW_REMOTE_CODE=0 refuses every model that does (default 1; see README).
# NER_MODEL_MULTI=multi-davlan-hrl
# NER_ALLOW_REMOTE_CODE=1

# -- uploaded documents
# Extracted text of uploaded documents waits here for its analysis job (kept 6 hours). Default: the system temp folder.
# Point it to a persistent folder or Docker volume so interrupted jobs can be restarted after a server restart.
# DOC_DIR=/data/annotationtool_docs

# -- memory limit for entity models
# Each NER model takes about 1 GB of RAM once loaded. At most NER_MAX_MODELS stay loaded; when another language needs a different model,
# the least recently used one is unloaded (and loaded again, in 20-30 s, if it is needed later). 0 = no limit. Raise it on a server with plenty of RAM.
# NER_MAX_MODELS=2

# -- where models are stored
# Models are downloaded once and cached. Put the cache on a drive with plenty of room; downloads and evaluation runs have
# failed here when the system drive filled up. Approximate sizes on disk: English NER bert-base 0.43 GB (roberta-large
# 1.4 GB), multilingual NER about 1.1 GB, each Marian translation direction 0.3 GB, each IndicTrans2 direction about 0.9 GB.
# A full set (English NER + Hindi both ways + 7 other languages) needs about 6-8 GB.
# HF_HOME=D:/hf-cache
# A warning is logged at startup, and shown by GET /health/models, when less than this many GB are free there.
# MIN_FREE_GB=3

# -- result cache
# NER and translation results are cached in a small SQLite file so the same text or file is not processed twice.
# The key covers the text, languages, model and settings, so a changed setting never returns an old result.
# The file holds pieces of processed text (entities, translations) on this machine only; delete it to clear them.
# RESULT_CACHE_PATH=~/.cache/annotation-tool/results.sqlite    # "off" disables the cache
# RESULT_CACHE_MAX_ROWS=50000

# -- model preloading
# Models to load and warm up when the server starts, so the first request is not slow (about 15 s for the English
# NER model otherwise). Comma-separated: ner_en, ner_multi, mt:<src>-<tgt> (for example mt:en-hi). "none" turns it off.
# Check what is loaded with GET /health/models. The server starts accepting requests only after this finishes.
PRELOAD_MODELS=ner_en

# -- Azure AI Translator (only needed if "azure" is in TRANSLATION_PROVIDERS)
# Create a "Translator" resource in the Azure portal (the Free F0 tier is enough), then Keys and Endpoint.
# Check your setup with:  python check_translation.py
AZURE_TRANSLATOR_KEY=
# Region shown next to the key, e.g. eastasia. Required for regional resources, optional for "Global".
AZURE_TRANSLATOR_REGION=
# Leave empty for the default https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_ENDPOINT=
# Send-rate cap in characters/minute. 30000 suits the free tier (about 33,300/minute); raise it on a paid tier.
AZURE_CHARS_PER_MINUTE=30000

# -- MyMemory (only if "mymemory" is in TRANSLATION_PROVIDERS)
# A contact email raises its free limit from ~5,000 to ~50,000 characters/day. Leave empty to stay anonymous.
MYMEMORY_EMAIL=
