# Settings for running everything locally with Docker:  docker compose up --build
# Copy this file to .env (same folder as docker-compose.yml) and fill in what you need. .env is git-ignored; never commit it.
# (For running the backend without Docker use backend/.env instead; for the Oracle server use deploy/oracle/.env.)

# Azure AI Translator: optional. Without a key only the offline models translate (slower; the first request per language downloads a model).
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Login token secret: any long random value, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, the backend uses a random secret per start (everyone is logged out when the container restarts).
JWT_SECRET=

# Hugging Face READ token, only while the English model's repository is private
HF_TOKEN=

# Optional overrides
# POSTGRES_PASSWORD=postgrespassword
# PRELOAD_MODELS=ner_en
# TRANSLATION_PROVIDERS=azure,local
