# Copy to .env on the VM and fill in. Never commit the filled-in file.

# The backend's public name; it must resolve to the VM's public IP. With the IP 129.154.1.2:
API_DOMAIN=129-154-1-2.sslip.io

# Database password: a new random value, e.g.  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Login token secret: a new random value, e.g.  openssl rand -hex 32   (never the one from a laptop)
JWT_SECRET=CHANGE_ME

# The frontend's production address on Vercel (comma-separated if several). This is all most setups need.
CORS_ORIGINS=https://annotation-tool-chi-eight.vercel.app
# Only if Vercel preview deployments must reach this backend: a pattern tied to the team name. Not airtight (anyone can name a Vercel
# project so that its address matches); the risk is limited because logins use a Bearer token, not cookies. Never .*
# CORS_ORIGIN_REGEX=^https://annotation-tool-[a-z0-9-]+-annotation-tool1\.vercel\.app$

# Models loaded at start. Loaded models keep memory use above 20%, which is one of the signs Oracle uses to decide that an
# Always Free VM is idle and may be reclaimed (CPU, network AND memory below 20% for 7 days). The first start downloads them (minutes).
PRELOAD_MODELS=ner_en,ner_multi
NER_MAX_MODELS=3
LOCAL_MT_MAX_LOADED=2
TORCH_THREADS=2

# Translation: Azure if a key is set, otherwise the offline models
TRANSLATION_PROVIDERS=azure,local
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Only while the English model's Hugging Face repository is private: a READ token. Without it English uses the fallback model.
HF_TOKEN=
